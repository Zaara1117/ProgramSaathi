# ==============================================================================
# ProgramSaathi - Environment Configuration Template
# Copy this file to .env and provide your deployment-specific configuration values.
# NEVER commit actual secrets, API keys, or credentials to version control.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=ProgramSaathi

# Microsoft Foundry / Azure OpenAI Service
# Provide either AZURE_OPENAI_ENDPOINT or FOUNDRY_PROJECT_ENDPOINT:
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
FOUNDRY_PROJECT_ENDPOINT=
# Model deployment name (e.g., 'gpt-4o', 'gpt-4o-mini'):
FOUNDRY_MODEL=gpt-4o
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# Authentication:
# Leave AZURE_OPENAI_API_KEY empty to authenticate automatically via DefaultAzureCredential (e.g. 'az login').
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
USE_AZURE_AD=false

# Azure Blob Storage (Document Lake)
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=programsaathi-documents
AZURE_STORAGE_CONNECTION_STRING=

# Azure AI Search (Hybrid Retrieval & Vector Search)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=programsaathi-index
AZURE_SEARCH_API_KEY=

# Azure SQL Database (Authoritative Project State & Audit Records)
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
